{
  "name": "notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "npm run build && wrangler dev --local-protocol https",
    "deploy": "npm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute notes-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute notes-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@fontsource/space-grotesk": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.78.0"
  }
}
